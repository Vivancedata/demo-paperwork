# Server-side only; never exposed to the browser.
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: extra hostnames (comma-separated) allowed to call the /api/<demo>/extract routes,
# on top of the demos' hosts in src/demos/registry.ts and this deployment's
# own Vercel URLs. localhost is always allowed under `next dev`.
# ALLOWED_ORIGINS="demo.example.com"

# Optional: which demo `/` opens on a host that is not one of the demos' own
# domains (paperwork, missed-call or field-photos). Unset, `/` lists all three.
# DEMO="paperwork"
